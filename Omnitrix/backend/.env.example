# Copy this file to .env and replace the placeholder values.
# Use Neon Dashboard > Connect > pooled connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/Interviewer?sslmode=require

# Local SLM provider. The first Qwen request downloads the model from Hugging Face.
AI_PROVIDER=qwen
QWEN_MODEL=Qwen/Qwen2.5-3B-Instruct
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_RESUME_BYTES=10485760
